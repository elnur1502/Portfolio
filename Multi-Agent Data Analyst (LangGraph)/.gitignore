# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/

# ---- Virtual envs ----
.venv/
venv/
env/
ENV/

# ---- Test / lint artifacts ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# ---- Logs ----
logs/*.log
logs/*.log.*
# keep the folder
!logs/.gitkeep

# ---- Secrets / local config ----
.env
.env.local
.env.*.local

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Sandbox-only artifacts (rebuild before use) ----
# ChromaDB binary store — generated by the agent on first run.
# Safe to delete; the agent will re-create empty collections.
# Comment out the next two lines if you want to commit your local index.
/chroma_db/*.bin
/chroma_db/*.sqlite*

# ---- JDBC drivers & truststores (license + secret) ----
# These are intentionally not shipped. Add your own before building.
ImpalaJDBC41.jar
truststore.jks
